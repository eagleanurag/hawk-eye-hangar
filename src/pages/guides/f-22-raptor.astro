<script>
  import '../../scripts/motion.js';

  /* ---------------------------------------------------------------
     Click-to-load video. Nothing third-party is requested until the
     visitor asks for it.
  --------------------------------------------------------------- */
  const YT = 'https://www.youtube-nocookie.com/embed/';
  for (const host of document.querySelectorAll('[data-video]')) {
    const btn = host.querySelector('[data-video-play]');
    const id = host.getAttribute('data-youtube');
    const title = host.getAttribute('data-title') ?? 'Video';
    if (!btn || !id) continue;
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = YT + id + '?autoplay=1&rel=0';
      frame.title = title;
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      host.replaceChildren(frame);
      host.classList.add('is-playing');
    });
  }

  /* ---------------------------------------------------------------
     Lightbox for the guide pages.
  --------------------------------------------------------------- */
  let lb = null;
  let lbImg = null;
  let lbCap = null;
  let lbPrev = null;
  let lbNext = null;
  let group = [];
  let at = 0;
  let restoreTo = null;

  function openLb(trigger) {
    group = Array.from(document.querySelectorAll('[data-glb]'));
    at = group.indexOf(trigger);
    if (at < 0) at = 0;
    restoreTo = trigger;

    lb = document.createElement('div');
    lb.className = 'lb';
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', 'Construction guide page, enlarged');
    lb.innerHTML =
      '<div class="lb-bar">' +
      '<p class="lb-cap" aria-live="polite"></p>' +
      '<button class="lb-x" type="button" aria-label="Close">✕</button>' +
    '</div>' +
    '<button class="lb-nav lb-nav--prev" type="button" aria-label="Previous page">‹</button>' +
    '<img class="lb-img" alt="">' +
    '<button class="lb-nav lb-nav--next" type="button" aria-label="Next page">›</button>';
    document.body.appendChild(lb);
    document.body.classList.add('no-scroll');

    lbImg = lb.querySelector('.lb-img');
    lbCap = lb.querySelector('.lb-cap');
    lbPrev = lb.querySelector('.lb-nav--prev');
    lbNext = lb.querySelector('.lb-nav--next');

    lb.querySelector('.lb-x').addEventListener('click', closeLb);
    lbPrev.addEventListener('click', () => stepLb(-1));
    lbNext.addEventListener('click', () => stepLb(1));
    lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', onLbKey, true);

    showLb();
    lb.querySelector('.lb-x').focus();
  }

  function showLb() {
    const t = group[at];
    if (!t) return;
    lbImg.src = t.getAttribute('data-glb');
    lbImg.alt = t.getAttribute('data-glb-alt') || '';
    lbCap.textContent = t.getAttribute('data-glb-cap') || '';
    lbPrev.disabled = at === 0;
    lbNext.disabled = at === group.length - 1;
  }

  function stepLb(d) {
    const n = at + d;
    if (n < 0 || n >= group.length) return;
    at = n;
    showLb();
  }

  function onLbKey(e) {
    if (!lb) return;
    if (e.key === 'Escape') { closeLb(); return; }
    if (e.key === 'ArrowLeft') { stepLb(-1); return; }
    if (e.key === 'ArrowRight') { stepLb(1); return; }
    if (e.key !== 'Tab') return;
    // keep focus inside the dialog
    const f = lb.querySelectorAll('button:not([disabled])');
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function closeLb() {
    if (!lb) return;
    lb.remove();
    lb = null;
    document.body.classList.remove('no-scroll');
    document.removeEventListener('keydown', onLbKey, true);
    if (restoreTo) restoreTo.focus();
  }

  for (const t of document.querySelectorAll('[data-glb]')) {
    t.addEventListener('click', (e) => { e.preventDefault(); openLb(t); });
  }

  /* ---------------------------------------------------------------
     Stage progress: rail on desktop, compact bar on mobile.
     One observer, no scroll handler.
  --------------------------------------------------------------- */
  const stages = Array.from(document.querySelectorAll('[data-stage]'));
  const railLinks = Array.from(document.querySelectorAll('[data-rail-link]'));
  const mobar = document.querySelector('[data-mobar]');
  const railCur = document.querySelector('[data-rail-cur]');
  const mobCur = document.querySelector('[data-mobar-cur]');
  const mobFill = document.querySelector('[data-mobar-fill]');
  const mobTitle = document.querySelector('[data-mobar-title]');
  const N = stages.length;

  function mark(i) {
    const s = stages[i];
    if (!s) return;
    const label = s.getAttribute('data-stage');
    if (railCur) railCur.textContent = label;
    if (mobCur) mobCur.textContent = label + ' / ' + String(N).padStart(2, '0');
    if (mobFill) mobFill.style.width = ((i + 1) / N) * 100 + '%';
    if (mobTitle && s.dataset.title) mobTitle.textContent = s.dataset.title;
    railLinks.forEach((a, j) => a.setAttribute('aria-current', j === i ? 'true' : 'false'));
  }

  if (stages.length) {
    const seen = new Array(N).fill(false);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const i = stages.indexOf(e.target);
          if (i >= 0 && e.isIntersecting) seen[i] = true;
        }
        // the topmost stage that has been on screen is the one you are reading
        let idx = seen.indexOf(true);
        if (idx < 0) idx = 0;
        for (let j = 0; j < N; j++) if (seen[j]) idx = j;
        mark(idx);
      },
      { rootMargin: '-72px 0px -55% 0px', threshold: 0 }
    );
    stages.forEach((s) => io.observe(s));
    mark(0);

    if (mobar && matchMedia('(max-width: 979px)').matches) mobar.hidden = false;
  }
</script>

