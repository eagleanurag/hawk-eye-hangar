---
import Shell from '../layouts/Shell.astro';
import Base from '../layouts/Base.astro';
import AircraftCard from '../components/AircraftCard.astro';
import { SITE, BASE, aircraft, stats, categories, designers, uncreditedCount, abs } from '../lib/catalog';

const base = BASE;
const featured = [...aircraft]
  .sort((a, b) => b.images.length - a.images.length || a.name.localeCompare(b.name))
  .slice(0, 8);

const statCards = [
  { label: 'Aircraft archived', value: stats.aircraft, sub: 'complete catalogue', accent: 'var(--cyan)' },
  { label: 'Plan files', value: stats.archived, sub: 'hosted in this repo', accent: 'var(--green)' },
  { label: 'Source links', value: stats.sourceOnly, sub: 'member-gated originals', accent: 'var(--amber)' },
  { label: 'Designers', value: stats.designers, sub: `${uncreditedCount} uncredited`, accent: 'var(--violet)' },
  { label: 'Categories', value: stats.categories, sub: 'from the source taxonomy', accent: 'var(--cyan)' },
  { label: 'Photographs', value: stats.images, sub: 'archived locally', accent: 'var(--green)' },
];

const topCategories = categories.slice(0, 6);
---

<Base
  title={SITE.name}
  description={SITE.description}
  canonical={abs('/')}
  image="/og-default.png"
>
  <Shell>
    <main id="main">
      <!-- ============================== HERO ============================== -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-gridlines" data-parallax="0.06" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <p class="eyebrow" data-reveal="fade">Independent preservation archive</p>
            <h1 id="hero-title" class="hero-title" data-reveal style="--reveal-delay:80ms">
              <span class="text-gradient">PARKJETS</span>
              <span class="hero-title-alt">ARCHIVE</span>
            </h1>
            <p class="hero-sub" data-reveal style="--reveal-delay:170ms">
              {SITE.tagline}
            </p>
            <p class="hero-lede" data-reveal style="--reveal-delay:240ms">
              A complete, searchable record of the Parkjets RC parkjet catalogue — every aircraft,
              its designer, the specifications they published, the build threads they linked and the
              photography that documented each build. Hosted independently of the original site.
            </p>

            <form class="hero-search" role="search" action={base + 'catalog'} data-reveal style="--reveal-delay:320ms" data-no-transition>
              <label class="visually-hidden" for="hero-q">Search the aircraft catalogue</label>
              <span class="hero-search-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" />
                </svg>
              </span>
              <input
                id="hero-q"
                name="q"
                type="search"
                placeholder="Search 109 aircraft — F-22, Mig-15, Shumate, EDF…"
                autocomplete="off"
                enterkeyhint="search"
              />
              <button class="btn btn--primary" type="submit">Search</button>
            </form>

            <div class="hero-actions" data-reveal style="--reveal-delay:390ms">
              <a class="btn btn--primary" href={base + 'catalog'}>
                Explore the catalogue
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
              <a class="btn btn--ghost" href={base + 'about#attribution'}>Attribution &amp; rights</a>
            </div>

            <p class="hero-note" data-reveal="fade" style="--reveal-delay:460ms">
              Archived from <a href={SITE.sourceCollection} rel="noopener nofollow" target="_blank">{SITE.sourceCollection.replace('https://', '')}</a>
              · Plan files remain with the original designers.
            </p>
          </div>

          <div class="hero-art" aria-hidden="true" data-tilt="4">
            <div class="hero-ring hero-ring--1"></div>
            <div class="hero-ring hero-ring--2"></div>
            <div class="hero-ring hero-ring--3"></div>
            <svg class="hero-plane" viewBox="0 0 400 200" role="presentation">
              <defs>
                <linearGradient id="pf" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#9fe9ff" stop-opacity="0.95" />
                  <stop offset="55%" stop-color="#4fd6ff" stop-opacity="0.55" />
                  <stop offset="100%" stop-color="#4fd6ff" stop-opacity="0.05" />
                </linearGradient>
              </defs>
              <g fill="url(#pf)" stroke="#4fd6ff" stroke-width="1.1" stroke-linejoin="round">
                <path d="M20 118 372 52l-58 62 58 34-352 12 44-26z" />
                <path d="M150 100 214 44l10 6-46 54z" opacity=".75" />
                <path d="M150 100 214 156l10-6-46-54z" opacity=".75" />
                <path d="M60 108 44 78l10-2 22 32z" opacity=".5" />
              </g>
              <g stroke="#4fd6ff" stroke-width="0.7" opacity=".55">
                <path d="M0 150h400M0 96h400M0 42h400" stroke-dasharray="3 9" />
                <path d="M96 0v200M200 0v200M304 0v200" stroke-dasharray="3 9" />
              </g>
            </svg>
            <div class="hero-readout">
              <span class="mono">CATALOGUE</span>
              <strong class="mono" data-count-to={stats.aircraft}>0</strong>
              <span class="mono">DESIGNS INDEXED</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ STATS ============================== -->
      <section class="section" aria-labelledby="stats-title">
        <div class="shell">
          <h2 id="stats-title" class="visually-hidden">Catalogue statistics</h2>
          <ul class="stat-grid" data-reveal>
            {statCards.map((s) => (
              <li class="stat panel brackets" style={`--accent:${s.accent}`}>
                <span class="stat-label mono">{s.label}</span>
                <strong class="stat-value" data-count-to={s.value}>0</strong>
                <span class="stat-sub">{s.sub}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ========================== CATEGORIES ========================== -->
      <section class="section" aria-labelledby="cat-title">
        <div class="shell">
          <div class="section-head" data-reveal>
            <p class="eyebrow">Browse by category</p>
            <h2 id="cat-title">Every airframe style in the collection</h2>
            <p class="muted">
              Categories are taken directly from the source taxonomy — nothing is invented or merged.
            </p>
          </div>
          <ul class="cat-grid" data-reveal>
            {topCategories.map((c, i) => (
              <li style={`--reveal-delay:${i * 50}ms`}>
                <a class="cat-card" href={`${base}catalog?category=${encodeURIComponent(c.value.toLowerCase())}`} data-no-transition>
                  <span class="cat-count mono">{c.count}</span>
                  <span class="cat-name">{c.value}</span>
                  <span class="cat-bar" aria-hidden="true">
                    <span style={`width:${Math.max(8, (c.count / stats.aircraft) * 100).toFixed(1)}%`}></span>
                  </span>
                </a>
              </li>
            ))}
            <li style={`--reveal-delay:${topCategories.length * 50}ms`}>
              <a class="cat-card cat-card--all" href={base + 'catalog'} data-no-transition>
                <span class="cat-count mono">{stats.aircraft}</span>
                <span class="cat-name">All aircraft</span>
                <span class="cat-bar" aria-hidden="true"><span style="width:100%"></span></span>
              </a>
            </li>
          </ul>
        </div>
      </section>

      <!-- =========================== FEATURED =========================== -->
      <section class="section" aria-labelledby="feat-title">
        <div class="shell">
          <div class="section-head section-head--row" data-reveal>
            <div>
              <p class="eyebrow">Selected aircraft</p>
              <h2 id="feat-title">The most fully documented builds</h2>
            </div>
            <a class="btn btn--ghost btn--sm" href={base + 'catalog'} data-no-transition>View all {stats.aircraft}</a>
          </div>
          <div class="grid-cards">
            {featured.map((a, i) => <AircraftCard aircraft={a} index={i} />)}
          </div>
        </div>
      </section>

      <!-- =========================== DESIGNERS ========================== -->
      <section class="section" aria-labelledby="designer-title">
        <div class="shell">
          <div class="section-head" data-reveal>
            <p class="eyebrow">Attribution</p>
            <h2 id="designer-title">{designers.length} credited designers</h2>
            <p class="muted">
              Every design in this archive is the work of an independent modeller. Their credit is
              recorded on each aircraft page and in the underlying dataset.
            </p>
          </div>
          <ul class="designer-cloud" data-reveal>
            {designers.slice(0, 28).map((d, i) => (
              <li style={`--reveal-delay:${Math.min(i, 10) * 35}ms`}>
                <a class="designer-chip" href={`${base}catalog?designer=${encodeURIComponent(d.value)}`} data-no-transition>
                  {d.value}<span class="mono">{d.count}</span>
                </a>
              </li>
            ))}
          </ul>
          <p style="margin-top:1.25rem" data-reveal>
            <a class="btn btn--ghost btn--sm" href={base + 'designers'} data-no-transition>All designers</a>
          </p>
        </div>
      </section>

      <!-- ============================== CTA ============================= -->
      <section class="section">
        <div class="shell">
          <div class="cta panel panel--pad brackets" data-reveal>
            <div>
              <p class="eyebrow">Help preserve the archive</p>
              <h2 style="font-size:var(--step-2);margin-block:.6rem .5rem">Know something this archive is missing?</h2>
              <p class="muted" style="max-width:60ch">
                The archive is built entirely from what the source site publicly exposed. If you have a
                build photograph, a corrected specification or a plan file the owner is happy to
                release, it can be added without touching any code — see the maintenance guide.
              </p>
            </div>
            <div class="cluster" style="--cluster-gap:.6rem;align-items:flex-start">
              <a class="btn btn--primary" href={base + 'about#adding'}>Add an aircraft</a>
              <a class="btn btn--ghost" href={SITE.repo} rel="noopener" target="_blank">View repository</a>
            </div>
          </div>
        </div>
      </section>
    </main>
  </Shell>
</Base>

<script>
  import '../scripts/motion.js';
</script>

<style>
  /* ------------------------------- hero ------------------------------- */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.5rem + 6vw, 7rem) clamp(2.5rem, 1rem + 4vw, 4.5rem);
    overflow: clip;
  }
  .hero-gridlines {
    position: absolute;
    inset: -10% -20%;
    z-index: -1;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--cyan) 8%, transparent) 0 1px, transparent 1px 88px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--cyan) 6%, transparent) 0 1px, transparent 1px 88px);
    mask-image: radial-gradient(70% 70% at 65% 35%, #000 0%, transparent 72%);
  }
  .hero-inner {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin-block: 0.5rem 0.85rem;
    display: grid;
  }
  .hero-title-alt {
    font-size: 0.42em;
    letter-spacing: 0.42em;
    color: var(--cyan);
    text-indent: 0.42em;
    margin-top: 0.35em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .hero-lede {
    margin-top: 0.9rem;
    max-width: 56ch;
    color: var(--text-dim);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .hero-note {
    margin-top: 1.1rem;
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .hero-note a {
    color: var(--cyan);
  }

  .hero-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0.4rem 0.4rem 0.4rem 2.9rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: color-mix(in oklab, var(--ink-750) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .hero-search:focus-within {
    border-color: color-mix(in oklab, var(--cyan) 60%, transparent);
    box-shadow: var(--glow);
  }
  .hero-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-faint);
    display: grid;
    place-items: center;
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    padding: 0.6rem 0.2rem;
    font-size: 0.98rem;
  }
  .hero-search input::placeholder {
    color: var(--text-faint);
  }
  .hero-search input:focus {
    outline: none;
  }
  .hero-search:focus-within .hero-search-icon {
    color: var(--cyan);
  }

  .hero-art {
    position: relative;
    aspect-ratio: 1 / 0.82;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    transition: transform 400ms var(--ease-out);
  }
  .hero-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--cyan) 22%, transparent);
    inset: 0;
  }
  .hero-ring--1 { animation: spin 44s linear infinite; border-style: dashed; }
  .hero-ring--2 { inset: 12%; animation: spin 30s linear infinite reverse; border-color: color-mix(in oklab, var(--violet) 22%, transparent); }
  .hero-ring--3 { inset: 24%; animation: spin 20s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero-plane {
    position: relative;
    width: min(100%, 460px);
    filter: drop-shadow(0 18px 40px color-mix(in oklab, var(--cyan) 30%, transparent));
    animation: plane-float 9s var(--ease-in-out) infinite;
  }
  @keyframes plane-float {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-14px) rotate(1deg); }
  }
  .hero-readout {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-soft);
    background: color-mix(in oklab, var(--ink-900) 78%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--text-faint);
  }
  .hero-readout strong {
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    color: var(--cyan);
    line-height: 1;
  }

  /* ------------------------------ sections --------------------------- */
  .section {
    padding-block: clamp(2.25rem, 1.2rem + 3.5vw, 4.5rem);
  }
  .section-head {
    max-width: 62ch;
    display: grid;
    gap: 0.55rem;
    margin-bottom: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }
  .section-head h2 {
    font-size: var(--step-3);
  }
  .section-head--row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .stat-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.6rem, 0.4rem + 0.6vw, 1rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 165px), 1fr));
  }
  .stat {
    --accent: var(--cyan);
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.1rem 1.15rem;
    overflow: hidden;
  }
  .stat::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent), transparent);
  }
  .stat-label {
    font-size: 0.64rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.3rem + 1.8vw, 2.9rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-sub {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .cat-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 215px), 1fr));
  }
  .cat-card {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.15rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: var(--panel);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }
  .cat-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--cyan) 45%, transparent);
    background: var(--panel-hi);
  }
  .cat-count {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--cyan);
    line-height: 1;
  }
  .cat-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .cat-bar {
    display: block;
    height: 3px;
    margin-top: 0.5rem;
    border-radius: 3px;
    background: color-mix(in oklab, var(--cyan) 12%, transparent);
    overflow: hidden;
  }
  .cat-bar span {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--cyan-deep), var(--cyan));
    transform-origin: left;
    animation: bar-grow 1.1s var(--ease-out) both;
  }
  @keyframes bar-grow { from { transform: scaleX(0); } }
  .cat-card--all .cat-count,
  .cat-card--all .cat-name {
    color: var(--text);
  }

  .designer-cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .designer-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: color-mix(in oklab, var(--ink-700) 60%, transparent);
    font-size: 0.86rem;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .designer-chip span {
    font-size: 0.68rem;
    color: var(--text-faint);
    background: color-mix(in oklab, var(--cyan) 12%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
  }
  .designer-chip:hover {
    border-color: color-mix(in oklab, var(--cyan) 55%, transparent);
    color: var(--cyan);
    transform: translateY(-2px);
  }

  .cta {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  /* --------------------------- responsive --------------------------- */
  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
      aspect-ratio: 1 / 0.55;
      max-width: 420px;
      margin-inline: auto;
      inline-size: 100%;
    }
    .hero-readout {
      right: -0.25rem;
      bottom: -0.5rem;
      padding: 0.5rem 0.7rem;
    }
    .hero-readout strong {
      font-size: 1.5rem;
    }
    .cta {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .hero-search {
      flex-wrap: wrap;
      padding: 0.65rem;
      border-radius: var(--radius);
    }
    .hero-search-icon {
      display: none;
    }
    .hero-search input {
      inline-size: 100%;
    }
    .hero-search .btn {
      inline-size: 100%;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
    .hero-title-alt {
      letter-spacing: 0.3em;
      text-indent: 0.3em;
    }
  }
</style>
