# ---- build output ---------------------------------------------------------
dist/
.astro/
node_modules/

# ---- migration working files ----------------------------------------------
# Raw evidence captured from the live site (collection JSON, HTTP cache, HAR
# analysis). Reproducible with `npm run migrate`; not worth versioning.
work/

# ---- generated QA artefacts -----------------------------------------------
# Regenerate with `npm run qa -- --shots`.
reports/screenshots/

# ---- migration runtime -----------------------------------------------------
# The recovery lock and the raw agent transcript are machine-local. The state,
# queue, completed/failed records, checkpoints and human-readable logs ARE
# committed: they are the audit trail.
.migration/resume.lock
.migration/logs/opencode-stdout.log
.migration/logs/opencode-stderr.log
.migration/logs/resume-prompt.txt

# ---- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---- OS / editor noise -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-error.log*

.vscode/
.idea/
*.swp
*.swo
