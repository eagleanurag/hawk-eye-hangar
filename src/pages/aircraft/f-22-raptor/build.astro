/* ---------------- lightbox ---------------- */
let lb=null,lbImg=null,lbCap=null,grp=[],at=0,restore=null;
function openLb(btn){
  grp=[...document.querySelectorAll('[data-glb]')];at=grp.indexOf(btn);if(at<0)at=0;restore=btn;
  lb=document.createElement('div');lb.className='lb';lb.setAttribute('role','dialog');lb.setAttribute('aria-modal','true');
  lb.innerHTML='<div class="lb-bar"><p class="lb-cap" aria-live="polite"></p><button class="lb-x" aria-label="Close">✕</button></div><button class="lb-nav p" aria-label="Previous">‹</button><img class="lb-img" alt=""><button class="lb-nav n" aria-label="Next">›</button>';
  document.body.appendChild(lb);document.body.style.overflow='hidden';
  lbImg=lb.querySelector('.lb-img');lbCap=lb.querySelector('.lb-cap');
  const P=lb.querySelector('.lb-nav.p'),N=lb.querySelector('.lb-nav.n');
  lb.querySelector('.lb-x').onclick=closeLb;P.onclick=()=>step(-1);N.onclick=()=>step(1);
  lb.onclick=e=>{if(e.target===lb)closeLb()};
  document.addEventListener('keydown',key,true);
  show();lb.querySelector('.lb-x').focus();
}
function show(){const t=grp[at];if(!t)return;lbImg.src=t.dataset.glb;lbImg.alt=t.dataset.cap||'';lbCap.textContent=t.dataset.cap||'';
  lb.querySelector('.lb-nav.p').disabled=at===0;lb.querySelector('.lb-nav.n').disabled=at===grp.length-1}
function step(d){const n=at+d;if(n<0||n>=grp.length)return;at=n;show()}
function key(e){if(!lb)return;if(e.key==='Escape')return closeLb();if(e.key==='ArrowLeft')return step(-1);if(e.key==='ArrowRight')return step(1);
  if(e.key!=='Tab')return;const f=[...lb.querySelectorAll('button:not([disabled])')];if(!f.length)return;
  const first=f[0],last=f[f.length-1];
  if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
  else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}
function closeLb(){if(!lb)return;lb.remove();lb=null;document.body.style.overflow='';document.removeEventListener('keydown',key,true);if(restore)restore.focus()}
document.querySelectorAll('[data-glb]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();openLb(b)}));

/* ---------------- hero aircraft scroll ----------------
   Same technique as the working standalone prototype: scroll progress across a
   tall section translates the aircraft with a composited transform only.
   No autoplay, no time-based animation, no layout properties touched. */
(() => {
  const section = document.getElementById('flight');
  const sticky  = document.getElementById('flightSticky');
  const plane   = document.getElementById('plane');
  const header  = document.querySelector('header.top');
  if (!section || !sticky || !plane) return;

  const mqReduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (mqReduce.matches) return;               // styles already neutralise it

  // park the sticky hero directly beneath the real header, whatever its height
  function measure() {
    if (!header) return;
    document.documentElement.style.setProperty('--fly-top', header.offsetHeight + 'px');
  }

  let raf = 0;
  function update() {
    raf = 0;
    const rect = section.getBoundingClientRect();
    const top = parseFloat(getComputedStyle(sticky).top) || 0;
    const travel = Math.max(1, rect.height - sticky.offsetHeight);
    const p = Math.min(1, Math.max(0, (top - rect.top) / travel));

    // motion sequence, all driven by scroll progress p (0..1):
  //   hold      the aircraft sits in its original position, unmoved
  //   roll      a full barrel roll while it is still around the middle
  //   exit      it tracks left until its tip is past the left edge
  //   release   p reaches 1, the hero unpins and the page carries on as normal
  const HOLD = 0.28, ROLL_END = 0.58, EXIT_START = 0.58;
  const ease = t => t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
  const span = (a, b) => Math.min(1, Math.max(0, (p - a) / (b - a)));

  const roll = ease(span(HOLD, ROLL_END));
  const distance = innerWidth * (innerWidth < 600 ? 1.5 : 1.15);
  const x = -distance * ease(span(EXIT_START, 1));
  // a very subtle forward scale so it reads as flight, not a flat carousel
  const scale = 1 + p * (innerWidth < 600 ? 0.04 : 0.08);

  // The jet is seen side-on, so a barrel roll reads as the airframe spinning
  // about its LONGITUDINAL axis - foreshortening to a blade at 90 deg and back
  // to full width at 180/360. A flat 2D rotate() would instead swing the 910px
  // fuselage outside the hero window and fill it with a slab.
  const spin = roll * 360;
  const bank = Math.sin(roll * Math.PI * 2) * 16;   // leans into and out of the roll

  plane.style.transform =
    `translate3d(${x.toFixed(2)}px,0,0) rotate(${bank.toFixed(2)}deg) rotateX(${spin.toFixed(2)}deg) scale(${scale.toFixed(4)})`;
  }

  function onScroll() { if (!raf) raf = requestAnimationFrame(update); }
  function onResize() { measure(); onScroll(); }

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onResize, { passive: true });
  measure();
  update();
})();
