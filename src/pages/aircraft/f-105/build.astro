---
/**
 * F 105 - How to Build.
 *
 * A thin route file, matching the F-22 precedent of one static route per
 * aircraft. All structure, styling and provenance handling live in the shared
 * AircraftBuildPage component, so the batch cannot drift into separate designs.
 *
 * Generated by work/extract-guides.py + work/render-guides.mjs. Content lives in
 * src/data/build-guides.data.ts; the renderer lives in
 * src/components/AircraftBuildPage.astro.
 */
import AircraftBuildPage from '../../../components/AircraftBuildPage.astro';
import { buildGuide } from '../../../data/build-guides';

const guide = buildGuide('f-105');
if (!guide) throw new Error('No How to Build guide for f-105');
---

<AircraftBuildPage guide={guide} />
