---
import { SITE, stats, BASE } from '../lib/catalog';
import '../styles/global.css';

const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/catalog', label: 'Catalogue' },
  { href: '/designers', label: 'Designers' },
  { href: '/about', label: 'About' },
];
const base = BASE;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(base.replace(/\/$/, '') + href));
/* One inline mark, reused in the header and the footer. */
const brandMark = `<svg width="24" height="24" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <path d="M6 32 17 12h30l11 20-11 20H17Z" fill="none" stroke="currentColor" stroke-opacity=".5" stroke-width="3" stroke-linejoin="round"/>
  <path d="M11 32c6.2-8.4 13-12.6 21-12.6S46.8 23.6 53 32c-6.2 8.4-13 12.6-21 12.6S17.2 40.4 11 32Z" fill="currentColor" fill-opacity=".92"/>
  <path d="M32 23.4 38.4 37 32 33.4 25.6 37Z" fill="#0a1220"/>
</svg>`;
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true" set:html={brandMark} />
      <span class="brand-text">
        EagleEye
        <small>Hangar</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Primary" data-nav>
      {nav.map((n) => (
        <a href={base + n.href.slice(1)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="btn btn--sm btn--primary" href={base + 'catalog'} style="margin-left:.5rem">
        Browse {stats.aircraft}
      </a>
    </nav>
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href={base} aria-label={`${SITE.name} — home`} style="margin-bottom:.9rem">
          <span class="brand-mark" aria-hidden="true" set:html={brandMark} />
          <span class="brand-text">EagleEye<small>Hangar</small></span>
        </a>
        <p class="muted" style="max-width:44ch;font-size:.92rem">
          An independent digital aviation library of RC aircraft plans, designs and build
          resources. Every design remains the work of its original designer.
        </p>
      </div>

      <div>
        <h2>Catalogue</h2>
        <ul>
          <li><a href={base + 'catalog'}>All aircraft</a></li>
          <li><a href={base + 'catalog?status=ARCHIVED'}>Archived plans</a></li>
          <li><a href={base + 'designers'}>Designers</a></li>
        </ul>
      </div>

      <div>
        <h2>Project</h2>
        <ul>
          <li><a href={base + 'about'}>About &amp; attribution</a></li>
          <li><a href={base + 'about#method'}>Migration method</a></li>
          <li><a href={base + 'about#adding'}>Adding an aircraft</a></li>
          <li><a href={SITE.repo}>Source repository</a></li>
        </ul>
      </div>

      <div>
        <h2>Original source</h2>
        <ul>
          <li><a href={SITE.sourceSite} rel="noopener noreferrer nofollow" target="_blank">parkjets.com</a></li>
          <li><a href={SITE.sourceCollection} rel="noopener noreferrer nofollow" target="_blank">Free plans collection</a></li>
          <li><a href={'mailto:' + SITE.contactEmail}>Contact the source</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>
        {SITE.name} is an independent digital aviation library. Design content © the original
        designers. Project code MIT licensed. Collection preserved from the original Parkjets
        catalogue; not affiliated with, or endorsed by, Parkjets LLC beyond preserving credited
        work.
      </p>
      <p class="mono">Static build · no trackers · no cookies</p>
    </div>
  </div>
</footer>
