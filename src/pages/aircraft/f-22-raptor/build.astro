<script is:inline>
const __root = document.querySelector('.f22build');
const __GUIDE__ = __root ? __root.dataset.guide : '';
const __IMG__ = __root ? __root.dataset.ac : '';

/* ---------------- video facade ---------------- */
const VIDEOS={
  'dXcSdekd8WA':'F-22 scratchbuild plane — Alex Ng',
  '2qOs0wHxfx8':'RC Raptor with thrust vectoring — Carl Lydick RC',
  '6iLRDalH1Iw':'F22 maiden flight — peter Roberts'
};
const vidHost=document.getElementById('vid'),vidBtn=document.getElementById('vidBtn');
let curVid='dXcSdekd8WA';
document.querySelectorAll('.vidpick button').forEach(b=>{
  b.addEventListener('click',()=>{
    curVid=b.dataset.vid;
    document.querySelectorAll('.vidpick button').forEach(x=>{
      const on=x.dataset.vid===curVid;
      x.classList.toggle('is-on',on);
      x.setAttribute('aria-pressed',String(on));
    });
    vidBtn.setAttribute('aria-label','Play video: '+VIDEOS[curVid]);
    document.getElementById('vidTitle').textContent=VIDEOS[curVid];
    const old=vidHost.querySelector('iframe');
    if(old){ old.remove(); vidHost.classList.remove('playing'); }
  });
});
vidBtn.addEventListener('click',()=>{
  const f=document.createElement('iframe');
  f.src='https://www.youtube-nocookie.com/embed/'+curVid+'?autoplay=1&rel=0';
  f.title=VIDEOS[curVid];
  f.allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
  f.allowFullscreen=true;
  vidHost.replaceChildren(f);vidHost.classList.add('playing');
});

/* ---------------- stages ---------------- */
const S=[
{n:'01',t:'Plan & prepare',p:[2],intro:'Adhesives, tape and template layout — before a single part is cut.',what:[
'Cut the paper part templates with scissors, trimming to within about 1/8" of the lines.',
'Test fit all templates on the foam sheet to minimise waste before committing.',
'Spray the back of each template LIGHTLY with 3M 77 and replace it in the same spot.',
'Cut every part on the lines with a sharp hobby knife, and keep the template stuck to the piece.'],
tools:['Paper templates','3M 77 spray','Scissors','Sharp knife','Foam sheet'],
tip:'Use as little epoxy as possible and save it for the wing spar and motor mounts. Microballons in the epoxy cut weight and fill gaps. The majority of the build wants a light, quick-drying adhesive — foam-safe CA, UHU Creativ or 3M 77.',
check:['Templates tacked with no gaps or overlaps','Parts cut on the line','Every part still has its template attached']},
{n:'02',t:'Cutting, bevels & heat forming',p:[3,4],intro:'All the forward fuselage bevels, then the heat-formed curves.',what:[
'Cut the beveled edges on all forward fuselage pieces as shown on the plans.',
'Draw a reference line inset from the edge by the dimension on the plans, then cut the bevel. Straight runs take a straightedge; curves are cut freehand.',
'Heat-soften the lower forward fuselage sides and bend one long gradual curve for the taper seen from above.',
'Add a quick twist at the aft end so the angled sides meet the vertical centreline support.'],
tools:['Sharp knife','Straightedge','Heat gun','Scrap foam'],
tip:'The curves need not be exact — the bulkheads hold the shape once the box closes. Make sure left and right are true mirror images.',
check:['Left and right are mirror images','Reference lines visible on every part','One smooth taper plus the aft twist']},
{n:'03',t:'Fuselage box & wing spar',p:[5],intro:'The bulkheads set the box; the spar sets the wing.',what:[
'Glue the bottom halves of the three fuselage bulkheads to one lower side, perpendicular.',
'Stand the sides upright and flat, glue the bulkhead edges, and bring the sides together.',
'Glue the aft ends together and make sure they are perfectly vertical.',
'Slot the carbon wing spar and epoxy it in. Clamp flat under wax paper and heavy books.',
'Sand the leading edge and tips round, tape with 3M Satin, then cut the flaperons free.'],
tools:['Bulkheads ×3','Carbon spar','30-min epoxy','Microballons','Wax paper & books','3M Satin tape'],
tip:'Mix microballons into the epoxy. You may need a little more heat forming to get the aft ends to align.',
check:['Bulkheads perpendicular','Aft ends vertical, not raked','Spar fully seated, wing stayed flat','Leading edge rounded and taped']},
{n:'04',t:'Aft fuselage & wing join',p:[6],intro:'Close the box around the wing, then bring the front fuselage on.',what:[
'Laminate the two fuselage centreline support pieces with 3M 77.',
'Bevel the aft fuselage sides, then glue them and the centreline piece under the wing.',
'Use the four temporary bulkheads to hold the correct angle, pinning as needed. Remove them once dry.',
'Glue the forward fuselage lower assembly to the front, mating its aft end to the leading edge of the centreline support.'],
tools:['3M 77','Aft sides','Centreline support ×2','Temporary bulkheads ×4','Pins','Gap-filling glue','Heat gun'],
tip:'The top of the forward fuselage deliberately droops a few degrees below the wing — that is the scale look. As long as the top mates flat against the wing underside the droop sets itself.',
check:['Forward fuselage flush with the centreline support','The twist is a smooth curve, not a crease','Temporary bulkheads removed, no gaps at the wing joint']},
{n:'05',t:'Motor mount',p:[7],intro:'The thrust vectoring mount. This whole stage is optional.',opt:true,what:[
'Drill the motor mount stick for the aluminium tube bearing and glue it in with thin CA. Chamfer the lower edge.',
'Wrap the aft end of the stick in packing tape for a low-friction surface.',
'Sand the inside faces of the two 1/8" plywood side plates and epoxy them to the movable part of the stick.',
'Drill the pivot hole through both plates at once, exactly perpendicular — use a drill press.',
'Trim the lower edges to clear the pushrod and clevis.'],
tools:['Motor mount stick','Aluminium bearing','1/8" ply side plates ×2','Thin CA','Epoxy','Packing tape','Drill press'],
tip:'The motor thrust line must run straight through the pivot pin, or the vectoring servo is loaded and the trim moves with throttle. A different motor may need new side plates from 1/8" ply to raise or lower the stick. <strong style="color:var(--orange)">Do not fit a bigger motor than the design assumes.</strong> The 3/8" hardwood and 1/8" ply vectoring system was sized for the Littlescreamers Park Jet Special. Steve was blunt about what a Grayson Super MegaJet does to it: "I don\'t think the 3/8" hardwood-1/8" ply TV system of the F-22 can stand up to the weight and power of the MegaJet. At best it will bend and torque and jam under power, and at worst it could break!" Either drop the vectoring and use the bigger motor, or stay near the LSPJ\'s weight and power.',
check:['Pivot hole goes through both plates in one pass, perpendicular','Pivots smoothly with no slop','Thrust line passes through the pivot pin','Lower edges clear the pushrod','Motor weight within what the TV mount can carry']},
{n:'06',t:'Stabilator & bearings',p:[8],intro:'Mount the stick, press the bearings, hang the stabilators.',what:[
'Glue the motor mount into the aft fuselage centreline slot at a zero-zero thrust line. 5-minute epoxy.',
'Press a circular notch in the aft edge of the wing with the aluminium bearings and glue them in.',
'Tape the bearings and insert the carbon tube pivot as the glue dries so everything aligns.',
'Sand the stabilator leading edges round and trailing edges tapered, then tape the leading edges.',
'Slide the pivot tube, end stops and control horn through the bearings. Glue the end stops with thin CA but NOT the control horn.'],
tools:['5-min epoxy','Bearing tubes ×2','Carbon pivot tube','Spare servo horns','Thin CA','Epoxy & microballons','3M Satin tape'],
tip:'End stops butt against the aluminium tubes so the pivot cannot slide sideways. Both end stops and the control arm come from spare servo horns drilled out to fit the carbon tube.',
check:['Motor mount at zero-zero','Bearings aligned, pivot runs free','End stops glued, control horn not yet','Stabilator moves along the whole pivot']},
{n:'07',t:'Servos & thrust vectoring',p:[9],intro:'Stabilator servo and pushrod, then the vectoring servo, guides and clevis.',what:[
'Fit the stabilator servo in its slot — thick CA holds it.',
'Make a music wire pushrod to the control horn and glue the horn with thin CA once aligned.',
'Add chordwise fibreglass strips to the stabilator roots, top and bottom, if you fly fast or land in tall grass.',
'Fit the vectoring servo in its slot, secured with CA.',
'Make the pushrod from 1/16" threaded music wire with a large Z-bend rising to the servo arm.',
'Fit pushrod guides to kill flex, and connect to the motor mount with a steel clevis.'],
tools:['Stabilator servo','HS-85MG or equiv (metal gear, 40+ oz/in)','Music wire','1/16" threaded wire','Thick & thin CA','Steel clevis','Scrap CF tube','Fibreglass + epoxy'],
tip:'A 40+ oz/in metal-geared servo is required — a plastic-geared one strips if the prop hits the ground. The prototype used a Hitec HS-85MG. Anchor the pushrod guides with fibreglass and epoxy or a rough landing shakes them loose.',
check:['Stabilator servo fully supported','Control horn glued only after alignment','Vectoring servo metal geared, 40+ oz/in','Pushrod runs straight, guides anchored','System moves freely with minimal slop']},
{n:'08',t:'Upper fuselage & turtledeck',p:[10,11,16],intro:'Close the top of the forward fuselage, fit the aft sides and the turtledeck, then the spine.',what:[
