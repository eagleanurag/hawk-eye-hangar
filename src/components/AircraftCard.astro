---
import { SITE, ARCHIVE_STATUS_META, cardSpecs, pub, type Aircraft } from '../lib/catalog';

interface Props {
  aircraft: Aircraft;
  index?: number;
  eager?: boolean;
}
const { aircraft: a, index = 0, eager = false } = Astro.props;
const base = SITE.base.endsWith('/') ? SITE.base : SITE.base + '/';
const href = `${base}aircraft/${a.slug}`;
const status = ARCHIVE_STATUS_META[a.archiveStatus] ?? ARCHIVE_STATUS_META.UNAVAILABLE;
const specs = cardSpecs(a);
const img = a.images[0];
const cats = a.category.join('|');
const designerKey = a.designerKey;

/*
 * Search index text is NOT emitted per card.
 *
 * It used to be a `data-search` attribute on every card, which meant ~60 KB of
 * HTML-escaped prose duplicated into 109 elements (and a further 16 KB in an
 * unused `data-specs` attribute). That is a large, mostly-invisible chunk of
 * the catalogue's 314 KB page weight.
 *
 * It is now emitted once, as a single JSON block keyed by slug, and read by
 * catalog.js. Nothing is lost: the same text is searchable, it is just not
 * repeated per element and it no longer pays HTML-attribute escaping.
 */
const searchIndexSlug = a.slug;

const specsText = Object.entries(a.specifications)
  .map(([k, v]) => `${k} ${v}`)
  .join(' ')
  .toLowerCase();
---

<article
  class="card"
  data-card
  data-slug={searchIndexSlug}
  data-name={a.name}
  data-display={a.displayName}
  data-designer={a.designer}
  data-designer-key={designerKey}
  data-categories={cats}
  data-category-slugs={a.category.map((c) => c.toLowerCase()).join('|')}
  data-status={a.archiveStatus}
  data-sort={a.name.toLowerCase()}
  data-images={a.images.length}
  data-added={a.source.addedOn ? Date.parse(a.source.addedOn) : 0}
  data-reveal
  style={`--reveal-delay:${Math.min(index, 11) * 45}ms`}
>
  <div class="card-media">
    {img?.card ? (
      <img
        src={pub(img.card)}
        srcset={`${pub(img.card)} 400w, ${pub(img.full ?? img.card)} 1200w`}
        sizes="(max-width: 640px) 92vw, (max-width: 1100px) 44vw, 300px"
        alt={img.alt}
        width={img.width ?? undefined}
        height={img.height ?? undefined}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <div class="card-media-empty" aria-hidden="true">No image archived</div>
    )}
    <div class="card-badges">
      {a.category.slice(0, 2).map((c) => <span class="chip chip--cyan">{c}</span>)}
    </div>
  </div>

  <div class="card-body">
    <h3 class="card-title">
      <a class="card-link" href={href}>{a.displayName}</a>
    </h3>
    <p class="card-designer">
      {a.designer ? (
        <>Designed by <span class="mono">{a.designer}</span></>
      ) : (
        <span class="faint">Designer not credited in source</span>
      )}
    </p>

    {specs.length > 0 ? (
      <p class="card-specs">
        {specs.map((k) => (
          <span>{k.replace(/([A-Z])/g, ' $1').trim()}: {a.specifications[k]}</span>
        ))}
      </p>
    ) : (
      <p class="card-specs card-specs--none">No published specifications</p>
    )}

    <p class="card-foot">
      <span class={`chip chip--${status.tone} card-status`}>{status.short}</span>
      <span class="card-cta">
        View
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </p>
  </div>
</article>

<style>
  .card-status {
    flex: none;
  }
  .card-media-empty {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  /*
   * The whole card is the click target, but the link TEXT must stay in normal
   * flow — an absolutely positioned anchor would collapse the heading to zero
   * height and paint the title over the badges. The pseudo-element on
   * .card-link (in global.css) gives the large hit area instead.
   */
  .card-link:focus-visible {
    outline: none;
  }
  .card:has(.card-link:focus-visible) {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
</style>
