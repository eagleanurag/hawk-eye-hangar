{
  "name": "parkjet-aircraft-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parkjets Archive — an independent, self-hosted preservation of the Parkjets RC aircraft plan catalogue.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "node scripts/discover-aircraft.mjs",
    "import": "node scripts/import-aircraft.mjs",
    "assets": "node scripts/extract-assets.mjs",
    "archive": "node scripts/archive-plans.mjs",
    "migrate": "npm run discover && npm run import && npm run assets && npm run archive && npm run report",
    "validate": "node scripts/validate-aircraft.mjs",
    "check-links": "node scripts/check-links.mjs",
    "qa": "node scripts/qa.mjs",
    "icons": "node scripts/gen-icons.mjs && node scripts/gen-og.mjs",
    "report": "node scripts/build-report.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "dev": "astro dev",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run validate && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
