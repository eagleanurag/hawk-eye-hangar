{
  "name": "hawk-eye-hangar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HawkEye Hangar - an independent digital aviation library of RC aircraft plans, designs and build resources.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "node scripts/discover-aircraft.mjs",
    "import": "node scripts/import-aircraft.mjs",
    "assets": "node scripts/extract-assets.mjs",
    "archive": "node scripts/archive-plans.mjs",
    "migrate": "npm run discover && npm run import && npm run assets && npm run archive && npm run report",
    "validate": "node scripts/validate-aircraft.mjs",
    "check-links": "node scripts/check-links.mjs",
    "qa": "node scripts/qa.mjs",
    "icons": "node scripts/gen-brand.mjs && node scripts/gen-og.mjs",
    "brand": "node scripts/gen-brand.mjs",
    "report": "node scripts/build-report.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "dev": "astro dev",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run validate && npm run test && npm run build && npm run check-links && npm run audit",
    "audit": "node scripts/audit.mjs",
    "state": "node scripts/migration-state.mjs show",
    "state:next": "node scripts/migration-state.mjs next",
    "state:evidence": "node scripts/migration-state.mjs evidence",
    "resume": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/resume-parkjets.ps1",
    "resume:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/resume-parkjets.ps1 -Status",
    "resume:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/resume-parkjets.ps1 -DryRun",
    "resume:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-parkjets-task.ps1",
    "ci:local": "npm run verify && npm run qa",
    "agent:test": "node --test tests/agent-control-plane.test.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "resume:uninstall-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-parkjets-task.ps1 -Uninstall",
    "archive:local": "node scripts/archive-plans.mjs --local-only"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.5"
  }
}
